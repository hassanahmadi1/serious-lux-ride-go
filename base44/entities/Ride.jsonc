{
  "name": "Ride",
  "type": "object",
  "properties": {
    "passenger_name": {
      "type": "string",
      "description": "\u0646\u0627\u0645 \u0645\u0633\u0627\u0641\u0631"
    },
    "passenger_phone": {
      "type": "string",
      "description": "\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633 \u0645\u0633\u0627\u0641\u0631"
    },
    "pickup_address": {
      "type": "string",
      "description": "\u0645\u0628\u062f\u0623"
    },
    "dropoff_address": {
      "type": "string",
      "description": "\u0645\u0642\u0635\u062f"
    },
    "car_class": {
      "type": "string",
      "enum": [
        "business",
        "luxury",
        "vip",
        "suv"
      ],
      "description": "\u06a9\u0644\u0627\u0633 \u062e\u0648\u062f\u0631\u0648"
    },
    "distance_km": {
      "type": "number",
      "description": "\u0645\u0633\u0627\u0641\u062a \u062a\u062e\u0645\u06cc\u0646\u06cc \u0628\u0647 \u06a9\u06cc\u0644\u0648\u0645\u062a\u0631"
    },
    "price": {
      "type": "number",
      "description": "\u06a9\u0631\u0627\u06cc\u0647 \u0646\u0647\u0627\u06cc\u06cc \u0628\u0647 \u062a\u0648\u0645\u0627\u0646"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0632\u0645\u0627\u0646 \u0633\u0641\u0631 (\u062e\u0627\u0644\u06cc \u06cc\u0639\u0646\u06cc \u0647\u0645\u06cc\u0646 \u062d\u0627\u0644\u0627)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "on_the_way",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_phone": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    },
    "car_name": {
      "type": "string",
      "description": "\u0645\u062f\u0644 \u062e\u0648\u062f\u0631\u0648\u06cc \u0631\u0627\u0646\u0646\u062f\u0647"
    },
    "plate_number": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "online"
      ],
      "default": "cash"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pickup_address",
    "dropoff_address",
    "car_class",
    "price",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}