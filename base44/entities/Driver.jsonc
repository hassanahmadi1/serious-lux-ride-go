{
  "name": "Driver",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u0627\u06cc\u0645\u06cc\u0644 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0631\u0627\u0646\u0646\u062f\u0647"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "car_model": {
      "type": "string",
      "description": "\u0645\u062f\u0644 \u062e\u0648\u062f\u0631\u0648"
    },
    "car_class": {
      "type": "string",
      "enum": [
        "business",
        "luxury",
        "vip",
        "suv"
      ]
    },
    "plate_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ],
      "default": "available"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name",
    "phone",
    "car_model",
    "car_class",
    "plate_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}